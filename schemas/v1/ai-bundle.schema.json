{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sos-decompiler.dev/schema/v1/ai-bundle.schema.json",
  "title": "SOS AI pipeline bundle",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "artifact_sha256", "provider", "model", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_sha256": {"type": ["string", "null"]},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "stages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "task",
          "status",
          "model",
          "prompt_version",
          "input_sha256",
          "output_sha256",
          "response",
          "error"
        ],
        "properties": {
          "task": {
            "enum": ["structure_recovery", "semantic_labeling", "explanation", "refinement"]
          },
          "status": {"enum": ["accepted", "not_available", "rejected"]},
          "model": {"type": "string"},
          "prompt_version": {"type": "string"},
          "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "output_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "response": {"type": ["object", "null"]},
          "error": {"type": ["string", "null"]}
        }
      }
    }
  }
}
