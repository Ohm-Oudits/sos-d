{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sos.invalid/schemas/v1/rebuild-judge.schema.json",
  "title": "SOS pinned SBF rebuild and deterministic binary comparison",
  "type": "object",
  "required": [
    "schema_version",
    "accepted",
    "minimum_score",
    "require_exact",
    "limitations",
    "build",
    "original",
    "candidate",
    "comparison"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "accepted": { "type": "boolean" },
    "minimum_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "require_exact": { "type": "boolean" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "build": { "$ref": "#/$defs/build" },
    "original": { "$ref": "binary-judge.schema.json#/$defs/artifact" },
    "candidate": { "$ref": "binary-judge.schema.json#/$defs/artifact" },
    "comparison": { "$ref": "binary-judge.schema.json#/$defs/comparison" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "build": {
      "type": "object",
      "required": [
        "status",
        "expected_solana_version",
        "expected_platform_tools_version",
        "expected_sbf_rustc_version",
        "solana_command",
        "solana_version",
        "cargo_build_sbf_command",
        "cargo_build_sbf_version",
        "cargo_command",
        "cargo_version",
        "manifest_path",
        "manifest_sha256",
        "workspace_lock_path",
        "workspace_lock_sha256",
        "package_source_root",
        "package_source_sha256",
        "package_source_file_count",
        "output_directory",
        "command_arguments",
        "duration_ms",
        "stdout",
        "stderr",
        "stdout_truncated",
        "stderr_truncated"
      ],
      "properties": {
        "status": { "type": "string", "const": "succeeded" },
        "expected_solana_version": { "type": "string" },
        "expected_platform_tools_version": { "type": "string" },
        "expected_sbf_rustc_version": { "type": "string" },
        "solana_command": { "type": "string" },
        "solana_version": { "type": "string" },
        "cargo_build_sbf_command": { "type": "string" },
        "cargo_build_sbf_version": { "type": "string" },
        "cargo_command": { "type": "string" },
        "cargo_version": { "type": "string" },
        "manifest_path": { "type": "string" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "workspace_lock_path": { "type": "string" },
        "workspace_lock_sha256": { "$ref": "#/$defs/sha256" },
        "package_source_root": { "type": "string" },
        "package_source_sha256": { "$ref": "#/$defs/sha256" },
        "package_source_file_count": { "type": "integer", "minimum": 1 },
        "output_directory": { "type": "string" },
        "command_arguments": { "type": "array", "items": { "type": "string" } },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "stdout_truncated": { "type": "boolean" },
        "stderr_truncated": { "type": "boolean" }
      }
    }
  }
}
