{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sos.invalid/schemas/v1/model-qualification-corpus.schema.json",
  "title": "SOS model qualification corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "cases"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "pseudocode", "required_concepts", "forbidden_fragments"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "category": {"type": "string", "minLength": 1, "maxLength": 256},
          "pseudocode": {"type": "string", "minLength": 1, "maxLength": 262144},
          "required_concepts": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          },
          "forbidden_fragments": {
            "type": "array",
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        }
      }
    }
  }
}
